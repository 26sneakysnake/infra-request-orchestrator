<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_expose_service" targetNamespace="http://bpmn.io/schema/bpmn" exporter="infra-request-orchestrator" exporterVersion="0.1.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.10.0">
  <bpmn:process id="expose_service" name="Exposition d'un service (NetCo)" isExecutable="true">
    <bpmn:documentation>Demande d'exposition d'un service sur le réseau NetCo (entreprise fictive), de la demande ServiceNow aux tickets clos. Phase P5 : qualification par un agent IA avec relance du demandeur ; VM sur vcsim en parallèle de Kubernetes quand la demande en réclame une ; en cas d'échec de la vérification, diagnostic par un agent IA, validation humaine, puis action de la liste autorisée ; documentation rédigée par un agent IA, contrôlée, puis jointe aux tickets.</bpmn:documentation>
    <bpmn:startEvent id="StartEvent_RequestReceived" name="Demande reçue (ServiceNow)">
      <bpmn:outgoing>Flow_ToJoinQualify</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="Gateway_JoinQualify">
      <bpmn:incoming>Flow_ToJoinQualify</bpmn:incoming>
      <bpmn:incoming>Flow_ReplyToQualify</bpmn:incoming>
      <bpmn:outgoing>Flow_ToQualify</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_QualifyRequest" name="Qualifier la demande (agent IA)">
      <bpmn:documentation>L'agent transforme le texte libre en formulaire structuré et cite le référentiel. Il propose ; la validation et la table DMN qui suivent décident.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="qualify-request" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToQualify</bpmn:incoming>
      <bpmn:outgoing>Flow_ToQualificationGateway</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_Qualification" name="Qualification ?" default="Flow_Complete">
      <bpmn:incoming>Flow_ToQualificationGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_OutOfScope</bpmn:outgoing>
      <bpmn:outgoing>Flow_Missing</bpmn:outgoing>
      <bpmn:outgoing>Flow_Complete</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_AskRequester" name="Demander les informations manquantes">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="ask-requester" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Missing</bpmn:incoming>
      <bpmn:outgoing>Flow_ToWaitReply</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:eventBasedGateway id="Gateway_WaitReply">
      <bpmn:incoming>Flow_ToWaitReply</bpmn:incoming>
      <bpmn:outgoing>Flow_ToReply</bpmn:outgoing>
      <bpmn:outgoing>Flow_ToNoReply</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="Event_RequesterReply" name="Réponse du demandeur">
      <bpmn:incoming>Flow_ToReply</bpmn:incoming>
      <bpmn:outgoing>Flow_ReplyToQualify</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_RequesterReply" messageRef="Message_RequesterReply" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="Event_NoReply" name="72 h sans réponse">
      <bpmn:incoming>Flow_ToNoReply</bpmn:incoming>
      <bpmn:outgoing>Flow_ToRejectNoReply</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_NoReply">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT72H</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="Task_RejectNoReply" name="Clore la demande sans réponse">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="reject-request" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="=[&#34;Sans réponse du demandeur sous 72 h : la demande est close, elle peut être déposée à nouveau.&#34;]" target="rejectionReasons" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToRejectNoReply</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEndNoReply</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_NoReply" name="Demande close sans réponse">
      <bpmn:incoming>Flow_ToEndNoReply</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Task_ValidateRequest" name="Valider la demande (référentiel)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="validate-request" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Complete</bpmn:incoming>
      <bpmn:outgoing>Flow_ToValidGateway</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_RequestValid" name="Demande conforme ?" default="Flow_Invalid">
      <bpmn:incoming>Flow_ToValidGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_Valid</bpmn:outgoing>
      <bpmn:outgoing>Flow_Invalid</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_RejectInvalid" name="Refuser la demande dans ServiceNow">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="reject-request" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Invalid</bpmn:incoming>
      <bpmn:incoming>Flow_OutOfScope</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEndInvalid</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_Invalid" name="Demande refusée">
      <bpmn:incoming>Flow_ToEndInvalid</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:businessRuleTask id="Task_ClassifyChange" name="Classer le changement">
      <bpmn:extensionElements>
        <zeebe:calledDecision decisionId="change_class" resultVariable="changeClass" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Valid</bpmn:incoming>
      <bpmn:outgoing>Flow_ToApprovalGateway</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="Gateway_NeedsApproval" name="Approbation nécessaire ?" default="Flow_NeedsApproval">
      <bpmn:incoming>Flow_ToApprovalGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_Standard</bpmn:outgoing>
      <bpmn:outgoing>Flow_NeedsApproval</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_ApproveChange" name="Approuver le changement">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="change-approval" />
        <zeebe:assignmentDefinition candidateGroups="cab" />
        <zeebe:priorityDefinition priority="=if changeClass = &#34;urgent&#34; then 90 else 50" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_NeedsApproval</bpmn:incoming>
      <bpmn:outgoing>Flow_ToApprovedGateway</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_Approved" name="Approuvé ?" default="Flow_Refused">
      <bpmn:incoming>Flow_ToApprovedGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_Approved</bpmn:outgoing>
      <bpmn:outgoing>Flow_Refused</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_RejectRefused" name="Notifier le refus dans ServiceNow">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="reject-request" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Refused</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEndRefused</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_Refused" name="Changement refusé">
      <bpmn:incoming>Flow_ToEndRefused</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Gateway_JoinApproval">
      <bpmn:incoming>Flow_Standard</bpmn:incoming>
      <bpmn:incoming>Flow_Approved</bpmn:incoming>
      <bpmn:outgoing>Flow_ToCreateChange</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_CreateChange" name="Créer le changement ServiceNow">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="create-sn-change" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToCreateChange</bpmn:incoming>
      <bpmn:outgoing>Flow_ToCreateJira</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_CreateJira" name="Créer le ticket Jira">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="create-jira-issue" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToCreateJira</bpmn:incoming>
      <bpmn:outgoing>Flow_ToFork</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="Gateway_Fork">
      <bpmn:incoming>Flow_ToFork</bpmn:incoming>
      <bpmn:outgoing>Flow_ToProvision</bpmn:outgoing>
      <bpmn:outgoing>Flow_ToVmGateway</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:exclusiveGateway id="Gateway_VmRequired" name="VM demandée ?" default="Flow_NoVm">
      <bpmn:incoming>Flow_ToVmGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_VmRequired</bpmn:outgoing>
      <bpmn:outgoing>Flow_NoVm</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_CreateVm" name="Créer la VM (vcsim)">
      <bpmn:documentation>Crée la VM sur vcsim, le simulateur de l'API vSphere du laboratoire : dossier, taille et réseau du référentiel (VM-01). Idempotent.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="create-vm" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_VmRequired</bpmn:incoming>
      <bpmn:outgoing>Flow_VmCreated</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_VmJoin">
      <bpmn:incoming>Flow_VmCreated</bpmn:incoming>
      <bpmn:incoming>Flow_NoVm</bpmn:incoming>
      <bpmn:outgoing>Flow_VmToJoin</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:parallelGateway id="Gateway_Join">
      <bpmn:incoming>Flow_ProvisionToJoin</bpmn:incoming>
      <bpmn:incoming>Flow_VmToJoin</bpmn:incoming>
      <bpmn:outgoing>Flow_ToRetryGateway</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="Task_Provision" name="Provisionner sur Kubernetes">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="provision-k8s" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToProvision</bpmn:incoming>
      <bpmn:outgoing>Flow_ProvisionToJoin</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_RetryVerify">
      <bpmn:incoming>Flow_ToRetryGateway</bpmn:incoming>
      <bpmn:incoming>Flow_RemediationToVerify</bpmn:incoming>
      <bpmn:incoming>Flow_ManualFixed</bpmn:incoming>
      <bpmn:outgoing>Flow_ToVerify</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_VerifyExposure" name="Vérifier l'exposition">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="verify-exposure" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToVerify</bpmn:incoming>
      <bpmn:outgoing>Flow_ToDocument</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="Event_VerificationFailed" name="Vérification en échec" attachedToRef="Task_VerifyExposure">
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="=verification" target="verification" />
          <zeebe:output source="=verificationAttempts" target="verificationAttempts" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_ToDiagnose</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorEventDefinition_VerificationFailed" errorRef="Error_VerificationFailed" />
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="Task_Diagnose" name="Diagnostiquer l'échec (agent IA)">
      <bpmn:documentation>L'agent lit un instantané du namespace avec des outils en lecture seule et les runbooks, puis propose une cause et une action de la liste autorisée. Il ne modifie rien.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="diagnose-failure" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToDiagnose</bpmn:incoming>
      <bpmn:outgoing>Flow_ToValidateRemediation</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Task_ValidateRemediation" name="Valider la remédiation">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="remediation-approval" />
        <zeebe:assignmentDefinition candidateGroups="ops" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToValidateRemediation</bpmn:incoming>
      <bpmn:outgoing>Flow_ToRemediationGateway</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_Remediation" name="Appliquer l'action ?" default="Flow_ManualFixed">
      <bpmn:incoming>Flow_ToRemediationGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_ApplyRemediation</bpmn:outgoing>
      <bpmn:outgoing>Flow_ManualFixed</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_ApplyRemediation" name="Appliquer la remédiation (liste autorisée)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="apply-remediation" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ApplyRemediation</bpmn:incoming>
      <bpmn:outgoing>Flow_RemediationToVerify</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_Document" name="Rédiger et joindre la documentation (agent IA)">
      <bpmn:documentation>L'agent rédige la fiche de service et le compte rendu du changement à partir des variables du processus. Un contrôle déterministe refuse toute valeur absente de ces variables ; le gabarit prend alors le relais. Les deux fichiers sont joints au ticket Jira et au changement ServiceNow.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="document-service" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToDocument</bpmn:incoming>
      <bpmn:outgoing>Flow_ToClose</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_CloseTickets" name="Clôturer les tickets">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="close-tickets" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToClose</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEndExposed</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_Exposed" name="Service exposé">
      <bpmn:incoming>Flow_ToEndExposed</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_ToJoinQualify" sourceRef="StartEvent_RequestReceived" targetRef="Gateway_JoinQualify" />
    <bpmn:sequenceFlow id="Flow_ToQualify" sourceRef="Gateway_JoinQualify" targetRef="Task_QualifyRequest" />
    <bpmn:sequenceFlow id="Flow_ToQualificationGateway" sourceRef="Task_QualifyRequest" targetRef="Gateway_Qualification" />
    <bpmn:sequenceFlow id="Flow_OutOfScope" name="hors périmètre" sourceRef="Gateway_Qualification" targetRef="Task_RejectInvalid">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=qualification.outOfScope = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Missing" name="informations manquantes" sourceRef="Gateway_Qualification" targetRef="Task_AskRequester">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=count(qualification.missing) &gt; 0</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Complete" name="complète" sourceRef="Gateway_Qualification" targetRef="Task_ValidateRequest" />
    <bpmn:sequenceFlow id="Flow_ToWaitReply" sourceRef="Task_AskRequester" targetRef="Gateway_WaitReply" />
    <bpmn:sequenceFlow id="Flow_ToReply" sourceRef="Gateway_WaitReply" targetRef="Event_RequesterReply" />
    <bpmn:sequenceFlow id="Flow_ToNoReply" sourceRef="Gateway_WaitReply" targetRef="Event_NoReply" />
    <bpmn:sequenceFlow id="Flow_ReplyToQualify" sourceRef="Event_RequesterReply" targetRef="Gateway_JoinQualify" />
    <bpmn:sequenceFlow id="Flow_ToRejectNoReply" sourceRef="Event_NoReply" targetRef="Task_RejectNoReply" />
    <bpmn:sequenceFlow id="Flow_ToEndNoReply" sourceRef="Task_RejectNoReply" targetRef="End_NoReply" />
    <bpmn:sequenceFlow id="Flow_ToValidGateway" sourceRef="Task_ValidateRequest" targetRef="Gateway_RequestValid" />
    <bpmn:sequenceFlow id="Flow_Valid" name="oui" sourceRef="Gateway_RequestValid" targetRef="Task_ClassifyChange">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=valid = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Invalid" name="non" sourceRef="Gateway_RequestValid" targetRef="Task_RejectInvalid" />
    <bpmn:sequenceFlow id="Flow_ToEndInvalid" sourceRef="Task_RejectInvalid" targetRef="End_Invalid" />
    <bpmn:sequenceFlow id="Flow_ToApprovalGateway" sourceRef="Task_ClassifyChange" targetRef="Gateway_NeedsApproval" />
    <bpmn:sequenceFlow id="Flow_Standard" name="standard" sourceRef="Gateway_NeedsApproval" targetRef="Gateway_JoinApproval">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=changeClass = "standard"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_NeedsApproval" name="normal ou urgent" sourceRef="Gateway_NeedsApproval" targetRef="Task_ApproveChange" />
    <bpmn:sequenceFlow id="Flow_ToApprovedGateway" sourceRef="Task_ApproveChange" targetRef="Gateway_Approved" />
    <bpmn:sequenceFlow id="Flow_Approved" name="oui" sourceRef="Gateway_Approved" targetRef="Gateway_JoinApproval">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=decision = "approve"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Refused" name="non" sourceRef="Gateway_Approved" targetRef="Task_RejectRefused" />
    <bpmn:sequenceFlow id="Flow_ToEndRefused" sourceRef="Task_RejectRefused" targetRef="End_Refused" />
    <bpmn:sequenceFlow id="Flow_ToCreateChange" sourceRef="Gateway_JoinApproval" targetRef="Task_CreateChange" />
    <bpmn:sequenceFlow id="Flow_ToCreateJira" sourceRef="Task_CreateChange" targetRef="Task_CreateJira" />
    <bpmn:sequenceFlow id="Flow_ToFork" sourceRef="Task_CreateJira" targetRef="Gateway_Fork" />
    <bpmn:sequenceFlow id="Flow_ToProvision" sourceRef="Gateway_Fork" targetRef="Task_Provision" />
    <bpmn:sequenceFlow id="Flow_ToVmGateway" sourceRef="Gateway_Fork" targetRef="Gateway_VmRequired" />
    <bpmn:sequenceFlow id="Flow_VmRequired" name="oui" sourceRef="Gateway_VmRequired" targetRef="Task_CreateVm">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=vmRequired = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_NoVm" name="non" sourceRef="Gateway_VmRequired" targetRef="Gateway_VmJoin" />
    <bpmn:sequenceFlow id="Flow_VmCreated" sourceRef="Task_CreateVm" targetRef="Gateway_VmJoin" />
    <bpmn:sequenceFlow id="Flow_VmToJoin" sourceRef="Gateway_VmJoin" targetRef="Gateway_Join" />
    <bpmn:sequenceFlow id="Flow_ProvisionToJoin" sourceRef="Task_Provision" targetRef="Gateway_Join" />
    <bpmn:sequenceFlow id="Flow_ToRetryGateway" sourceRef="Gateway_Join" targetRef="Gateway_RetryVerify" />
    <bpmn:sequenceFlow id="Flow_ToVerify" sourceRef="Gateway_RetryVerify" targetRef="Task_VerifyExposure" />
    <bpmn:sequenceFlow id="Flow_ToDiagnose" sourceRef="Event_VerificationFailed" targetRef="Task_Diagnose" />
    <bpmn:sequenceFlow id="Flow_ToValidateRemediation" sourceRef="Task_Diagnose" targetRef="Task_ValidateRemediation" />
    <bpmn:sequenceFlow id="Flow_ToRemediationGateway" sourceRef="Task_ValidateRemediation" targetRef="Gateway_Remediation" />
    <bpmn:sequenceFlow id="Flow_ApplyRemediation" name="oui" sourceRef="Gateway_Remediation" targetRef="Task_ApplyRemediation">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=remediationDecision = "apply" and diagnosis.action != "escalate"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ManualFixed" name="corrigé à la main" sourceRef="Gateway_Remediation" targetRef="Gateway_RetryVerify" />
    <bpmn:sequenceFlow id="Flow_RemediationToVerify" sourceRef="Task_ApplyRemediation" targetRef="Gateway_RetryVerify" />
    <bpmn:sequenceFlow id="Flow_ToDocument" sourceRef="Task_VerifyExposure" targetRef="Task_Document" />
    <bpmn:sequenceFlow id="Flow_ToClose" sourceRef="Task_Document" targetRef="Task_CloseTickets" />
    <bpmn:sequenceFlow id="Flow_ToEndExposed" sourceRef="Task_CloseTickets" targetRef="End_Exposed" />
  </bpmn:process>
  <bpmn:message id="Message_RequesterReply" name="requester-reply">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=ritmNumber" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:error id="Error_VerificationFailed" name="Vérification en échec" errorCode="VERIFICATION_FAILED" />
  <bpmndi:BPMNDiagram id="BPMNDiagram_expose_service">
    <bpmndi:BPMNPlane id="BPMNPlane_expose_service" bpmnElement="expose_service">
      <bpmndi:BPMNShape id="StartEvent_RequestReceived_di" bpmnElement="StartEvent_RequestReceived">
        <dc:Bounds x="152" y="182" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="127" y="225" width="86" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_JoinQualify_di" bpmnElement="Gateway_JoinQualify" isMarkerVisible="true">
        <dc:Bounds x="235" y="175" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_QualifyRequest_di" bpmnElement="Task_QualifyRequest">
