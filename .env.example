# Copy to .env (ignored by git) and fill in locally. CI uses GitHub Actions secrets with the same names.

# ServiceNow personal developer instance (phase P1)
SERVICENOW_INSTANCE_URL=https://devXXXXXX.service-now.com
SERVICENOW_USERNAME=
SERVICENOW_PASSWORD=

# Jira Cloud free site (phase P1)
JIRA_BASE_URL=https://your-site.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=NETOPS

# Dedicated Anthropic API key with a spending limit (phase P3)
ANTHROPIC_API_KEY=
# replay (cassettes only, the default without a key) | record (API + store new answers) | live
NETCO_LLM_MODE=
NETCO_LLM_MODEL=claude-sonnet-5-5
NETCO_LLM_EFFORT=medium
# Cumulative cap on live LLM spend, in USD (ledger in out/llm-spend.json)
NETCO_LLM_BUDGET_USD=3

# Local Camunda stack started by `make up` (lightweight compose: unprotected API, UI login demo/demo)
CAMUNDA_REST_ADDRESS=http://localhost:8080
